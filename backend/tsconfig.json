{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "types": ["node"],
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}